# =============================================================================
# UPEA Vota — Variables de Entorno (EJEMPLO)
# =============================================================================
# Copia este archivo como .env y completa los valores.
# NUNCA subas .env a GitHub (está en .gitignore).
#
# Para producción, configura estas variables en:
#   - Render (Dashboard → Environment)
#   - Vercel  (Dashboard → Settings → Environment Variables)
# =============================================================================

# ── Supabase (Base de datos + Storage + Auth) ────────────────────────────
# Obtén estos valores en: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIs...  # anon public key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...  # service_role key (SECRETO)

# ── JWT ──────────────────────────────────────────────────────────────────
# Genera una clave segura con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=cambia_esto_por_una_clave_segura_de_al_menos_32_caracteres

# ── CORS ─────────────────────────────────────────────────────────────────
# Dominios permitidos separados por coma (sin espacios)
# Ejemplo: https://miapp.vercel.app,https://midominio.com
CORS_ORIGINS=https://tu-frontend.vercel.app

# ── reCAPTCHA v2 — "No soy un robot" ────────────────────────────────────
# Obtén las llaves en: https://www.google.com/recaptcha/admin
RECAPTCHA_SECRET_KEY=6Lf..._secret
RECAPTCHA_SKIP_VERIFICATION=false  # ¡false en producción!

# ── Biometría Facial ─────────────────────────────────────────────────────
FACE_MATCH_THRESHOLD=0.55  # 0=estricto, 1=permisivo

# ── SMTP (Correos electrónicos) ─────────────────────────────────────────
# Opcional. Sin esto, la recuperación de contraseña no enviará correos.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASSWORD=tu-contraseña-de-aplicacion
SMTP_FROM_EMAIL=noreply@upeavota.com

# =============================================================================
# VARIABLES DEL FRONTEND (se configuran en Vercel, no en .env local)
# =============================================================================
# VITE_API_URL=https://tu-api.onrender.com/api/v1
# VITE_RECAPTCHA_SITE_KEY=6Lf..._site
# =============================================================================
